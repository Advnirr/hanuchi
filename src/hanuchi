class ConfigManager:
    @staticmethod
    def load():
        os.makedirs(CONFIG_DIR, exist_ok=True)
        if not os.path.exists(CONFIG_FILE):
            loc = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES")
                   or os.environ.get("LANG") or "")
            default_conf = {"language": "ru" if loc.lower().startswith("ru") else "en"}
            ConfigManager.save(default_conf)
            return default_conf
        try:
            with open(CONFIG_FILE) as f:
                return json.load(f)
        except (OSError, ValueError) as e:
            log(f"Failed to read config, using defaults: {e}")
            return {"language": "en"}

    @staticmethod
    def save(conf):
        try:
            with open(CONFIG_FILE, 'w') as f:
                json.dump(conf, f)
        except OSError as e:
            log(f"Failed to save config: {e}")


