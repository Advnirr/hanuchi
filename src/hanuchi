def tr(key):
    return TRANSLATIONS[LANG_CODE].get(key, key)


def tr_self_status(status):
    s = status.lower()
    if s.startswith("logged in"):
        return tr("st_online")
    if s.startswith("logging in"):
        return tr("st_logging_in")
    if s.startswith("offline"):
        return tr("st_offline")
    return status


def set_language(code):
    global LANG_CODE
    if code in TRANSLATIONS:
        LANG_CODE = code


