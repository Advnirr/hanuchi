class HamachiBackend:
    @staticmethod
    def _find_exe():
        for p in ("/usr/bin/hamachi", "/opt/logmein-hamachi/bin/hamachi"):
            if os.access(p, os.X_OK):
                return p
        return shutil.which("hamachi") or "hamachi"

    @staticmethod
    def _run(args, stdin_text=""):
        """Run hamachi and return (returncode, stdout, stderr); rc is None if it did not run.

        stdin is always a pipe so a prompt can never hang waiting on a terminal.
        The argument list is fixed and shell=True is never used.
        """
        cmd = [HamachiBackend._find_exe(), *args]
        log(f"Exec: {' '.join(cmd)}")
        try:
            r = subprocess.run(cmd, input=stdin_text, capture_output=True,  # nosec B603
                               text=True, timeout=30, check=False)
        except subprocess.TimeoutExpired:
            log("EXEC TIMEOUT: hamachi did not respond in time")
            return None, "", "timeout"
        except OSError as e:
            log(f"EXEC ERROR: {e}")
            return None, "", str(e)
        return r.returncode, r.stdout, r.stderr

    @staticmethod
    def _action(args, stdin_text=""):
        """Run a state-changing command and return (ok, message).

        hamachi exits 0 even when a command is refused ("Joining x .. failed,
        invalid password"), so the output is inspected as well as the return code.
        """
        rc, out, err = HamachiBackend._run(args, stdin_text)
        if rc is None:
            return False, err
        msg = " ".join((out + err).replace("Password:", "").split())
        ok = rc == 0 and "failed" not in msg.lower()
        if not ok:
            log(f"Command failed (rc={rc}): {msg}")
            # Keep only the reason: "Joining x .. failed, invalid password" -> "invalid password".
            msg = msg.split("failed", 1)[-1].lstrip(" ,:") or msg
        return ok, msg[:200]

    @staticmethod
    def get_self_info():
        _, raw, _ = HamachiBackend._run([])
        if not raw or "does not seem to be running" in raw:
            return {}
        info = {}
        for line in raw.split('\n'):
            if ':' in line:
                key, val = line.split(':', 1)
                info[key.strip().lower()] = val.strip()
        return info

    @staticmethod
    def start_daemon_pkexec():
        log("Attempting to start daemon via pkexec...")
        pkexec = shutil.which("pkexec") or "/usr/bin/pkexec"
        systemctl = shutil.which("systemctl") or "/usr/bin/systemctl"
        try:
            subprocess.run([pkexec, systemctl, "start", "logmein-hamachi"],  # nosec B603
                           check=True, timeout=120)
            time.sleep(2)
            return True
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError) as e:
            log(f"Failed to start daemon via pkexec (cancelled or error): {e}")
            return False

    @staticmethod
    def get_networks():
        _, raw, _ = HamachiBackend._run(['list'])
        networks = []
        current_net = None
        for raw_line in raw.split('\n'):
            line = raw_line.strip()
            if not line:
                continue
            # Network header: " * [id]  name  capacity: 4/5, ..., owner: This computer"
            # The leading marker is '*' when this node is online in the network.
            if '[' in line and 'capacity:' in line:
                marker, _, after = line.partition('[')
                net_id, _, right_part = after.partition(']')
                net_id = net_id.strip()
                net_name, _, rest = right_part.partition('capacity:')
                fields = {}
                for chunk in ('capacity:' + rest).split(','):
                    k, sep, v = chunk.partition(':')
                    if sep:
                        fields[k.strip().lower()] = v.strip()
                owner = fields.get('owner', '')
                current_net = {
                    'id': net_id,
                    'name': net_name.strip() or net_id,
                    'capacity': fields.get('capacity', '?'),
                    'owner': owner,
                    'is_owner': owner.lower() == 'this computer',
                    'online': marker.strip() == '*',
                    'members': [],
                }
                networks.append(current_net)
                continue
            if current_net is None:
                continue
            parts = line.split()
            # Member line: [marker] <client id> <nickname...> <ip> alias: ... [ipv6] [direct|via relay] [tunnel]
            ip = next((p for p in parts if p.startswith(("25.", "2620:"))), None)
            if ip is None:
                continue
            ip_idx = parts.index(ip)
            id_idx = next((i for i, t in enumerate(parts[:ip_idx])
                           if CLIENT_ID_RE.match(t)), None)
            if id_idx is None:
                continue
            marker = " ".join(parts[:id_idx])
            member_id = parts[id_idx]
            nick = " ".join(parts[id_idx + 1:ip_idx]).strip() or member_id
            tail = " ".join(parts[ip_idx + 1:]).lower()
            state = {'*': 'online', 'x': 'unreachable'}.get(marker, 'offline')
            conn = None
            if state == 'online':
                if 'direct' in tail:
                    conn = 'direct'
                elif 'via' in tail:
                    conn = 'relay'
            current_net['members'].append({'id': member_id, 'alias': nick, 'ip': ip,
                                           'state': state, 'conn': conn})
        return networks

    @staticmethod
    def login():
        # 'hamachi login' both registers the node on first use and brings it online.
        return HamachiBackend._action(['login'])

    @staticmethod
    def logoff():
        return HamachiBackend._action(['logoff'])

    # The password goes through stdin (hamachi prompts for it when it is not
    # on the command line), so it never shows up in argv / ps.
    @staticmethod
    def join_network(nid, pw):
        return HamachiBackend._action(['join', nid], pw + "\n")

    @staticmethod
    def create_network(nid, pw):
        return HamachiBackend._action(['create', nid], pw + "\n")

    @staticmethod
    def leave_network(nid):
        return HamachiBackend._action(['leave', nid])

    @staticmethod
    def delete_network(nid):
        return HamachiBackend._action(['delete', nid])

    @staticmethod
    def evict_member(nid, cid):
        return HamachiBackend._action(['evict', nid, cid])

    @staticmethod
    def ban_member(nid, cid):
        # Hamachi has no per-member ban: 'reject' only declines *pending* join
        # requests. Evict the peer, then lock the network to manual approval so
        # it cannot simply rejoin.
        ok, msg = HamachiBackend._action(['evict', nid, cid])
        if not ok:
            return ok, msg
        return HamachiBackend._action(['set-access', nid, 'lock', 'manual'])


def make_alert(parent, heading, body):
    if HAS_ADW_DIALOGS:
        return Adw.AlertDialog(heading=heading, body=body)
    return Adw.MessageDialog(transient_for=parent, modal=True, heading=heading, body=body)


def present_dialog(dialog, parent):
    if HAS_ADW_DIALOGS:
        dialog.present(parent)
    else:
        dialog.present()


class SettingsDialog:
    def __init__(self, win):
        self.win = win
        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup()
        page.add(group)

        self.lang_row = Adw.ComboRow(title=tr("language"),
                                     model=Gtk.StringList.new([name for _, name in LANGUAGES]))
        codes = [code for code, _ in LANGUAGES]
        self.lang_row.set_selected(codes.index(LANG_CODE) if LANG_CODE in codes else 0)
        self.lang_row.connect("notify::selected", self.on_lang_change)
        group.add(self.lang_row)

        self.theme_row = Adw.ComboRow(title=tr("theme"))
        self._fill_themes()
        theme = ConfigManager.load().get("theme", "system")
        self.theme_row.set_selected(THEMES.index(theme) if theme in THEMES else 0)
        self.theme_row.connect("notify::selected", self.on_theme_change)
        group.add(self.theme_row)

        if HAS_ADW_DIALOGS:
            self.dialog = Adw.PreferencesDialog(title=tr("settings"))
        else:
            self.dialog = Adw.PreferencesWindow(transient_for=win, modal=True, title=tr("settings"))
        self.dialog.set_search_enabled(False)
        self.dialog.add(page)

    def _fill_themes(self):
        self.theme_row.set_model(Gtk.StringList.new([tr("theme_" + t) for t in THEMES]))

    def present(self):
        present_dialog(self.dialog, self.win)

    def on_lang_change(self, row, _pspec):
        new_lang = LANGUAGES[row.get_selected()][0]
        if new_lang == LANG_CODE:
            return
        cfg = ConfigManager.load()
        cfg["language"] = new_lang
        ConfigManager.save(cfg)
        set_language(new_lang)
        self.dialog.set_title(tr("settings"))
        self.lang_row.set_title(tr("language"))
        self.theme_row.set_title(tr("theme"))
        # Replacing the model resets the selection, so restore it quietly.
        selected = self.theme_row.get_selected()
        self.theme_row.handler_block_by_func(self.on_theme_change)
        self._fill_themes()
        self.theme_row.set_selected(selected)
        self.theme_row.handler_unblock_by_func(self.on_theme_change)
        self.win.apply_language()

    def on_theme_change(self, row, _pspec):
        theme = THEMES[row.get_selected()]
        cfg = ConfigManager.load()
        if theme != cfg.get("theme"):
            cfg["theme"] = theme
            ConfigManager.save(cfg)
        apply_theme(theme)


class HanuchiWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=tr("title"))
        self.set_default_size(860, 580)
        self.set_resizable(False)
        self.set_icon_name("hanuchi")
        self.auto_start_attempted = False
        self.auto_login_attempted = False
        self.networks_data = []
        self.current_net_id = None
        self.is_online = False
        self._busy = 0
        self._refresh_gen = 0
        self._refreshing = False
        self._last_state = None

        main_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.toasts = Adw.ToastOverlay()
        self.toasts.set_child(main_box)
        self.set_content(self.toasts)

        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        sidebar.set_size_request(250, -1)
        header_l = Gtk.HeaderBar()
        header_l.set_show_title_buttons(False)
        header_l.set_title_widget(Gtk.Label())  # the window title is already on the right
        self.home_btn = Gtk.Button(icon_name="go-home-symbolic")
        self.home_btn.connect("clicked", self.go_dashboard)
        header_l.pack_start(self.home_btn)
        self.menu_btn = Gtk.MenuButton(icon_name="open-menu-symbolic")
        header_l.pack_start(self.menu_btn)
        self.refresh_btn = Gtk.Button(icon_name="view-refresh-symbolic", action_name="win.refresh")
        header_l.pack_end(self.refresh_btn)

        self.list_box = Gtk.ListBox()
        self.list_box.add_css_class("navigation-sidebar")
        self._row_handler = self.list_box.connect("row-selected", self.on_network_selected)
        self.list_scroll = self._scrolled(self.list_box)
        self.list_scroll.set_vexpand(True)
        sidebar.append(header_l)
        sidebar.append(self.list_scroll)

        content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content_box.set_hexpand(True)
        header_r = Gtk.HeaderBar()
        header_r.set_show_title_buttons(True)
        self.spinner = Gtk.Spinner()
        header_r.pack_end(self.spinner)
        self.power_btn = Gtk.Button()
        self.power_btn.set_visible(False)
        self.power_btn.connect("clicked", self.on_power_clicked)
        header_r.pack_end(self.power_btn)
        content_box.append(header_r)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_vexpand(True)
        self.dash_page = self._page_box()
        self.dash_scroll = self._scrolled(self.dash_page)
        self.stack.add_named(self.dash_scroll, "dashboard")
        self.net_page = self._page_box()
        self.net_scroll = self._scrolled(self.net_page)
        self.stack.add_named(self.net_scroll, "details")
        content_box.append(self.stack)

        main_box.append(sidebar)
        main_box.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
        main_box.append(content_box)

        for name, handler in (
            ("join_network", lambda *_: self.network_dialog("join")),
            ("create_network", lambda *_: self.network_dialog("create")),
            ("settings", lambda *_: SettingsDialog(self).present()),
            ("about", lambda *_: self.show_about()),
            ("refresh", lambda *_: self.refresh_data()),
        ):
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", handler)
            self.add_action(action)

        self.apply_tooltips()
        GLib.timeout_add_seconds(AUTO_REFRESH_SECONDS, self._auto_refresh)
        self.refresh_data()

    @staticmethod
    def _page_box():
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
        box.set_margin_top(30)
        box.set_margin_start(30)
        box.set_margin_end(30)
        box.set_margin_bottom(30)
        return box

    @staticmethod
    def _scrolled(child):
        # Keeps tall pages (many members) from growing the fixed-size window.
        sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        sw.set_propagate_natural_height(False)
        sw.set_child(child)
        return sw

    @staticmethod
    def _keep_scroll(scrolled, build):
        """Rebuild a page without jumping back to the top."""
        adj = scrolled.get_vadjustment()
        pos = adj.get_value()
        build()

        def restore():
            adj.set_value(pos)
            return GLib.SOURCE_REMOVE
        GLib.idle_add(restore)

    def build_menu(self):
        menu = Gio.Menu()
        menu.append(tr("join"), "win.join_network")
        menu.append(tr("create"), "win.create_network")
        section = Gio.Menu()
        section.append(tr("settings"), "win.settings")
        section.append(tr("about"), "win.about")
        menu.append_section(None, section)
        return menu

    def apply_tooltips(self):
        self.menu_btn.set_menu_model(self.build_menu())
        self.home_btn.set_tooltip_text(tr("home"))
        self.menu_btn.set_tooltip_text(tr("menu"))
        self.refresh_btn.set_tooltip_text(tr("refresh") + " (Ctrl+R)")
        self.power_btn.set_tooltip_text(tr("go_offline") if self.is_online else tr("go_online"))

    def apply_language(self):
        self.set_title(tr("title"))
        self.apply_tooltips()
        self.refresh_data()

    def go_dashboard(self, *_args):
        self.current_net_id = None
        self.list_box.unselect_all()
        self.stack.set_visible_child_name("dashboard")

