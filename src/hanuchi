            "application_icon": "hanuchi",
            "developer_name": "Advnirr",
            "version": APP_VERSION,
            "comments": tr("about_comment"),
            "website": WEBSITE_URL,
            "issue_url": REPO_URL + "/issues",
            "license_type": Gtk.License.MIT_X11,
        }
        if HAS_ADW_DIALOGS:
            about = Adw.AboutDialog(**props)
        else:
            about = Adw.AboutWindow(transient_for=self, modal=True, **props)
        about.add_link(tr("about_repo"), REPO_URL)
        present_dialog(about, self)

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast.new(text))

    def copy(self, text):
        copy_to_clipboard(text)
        self.toast(tr("copied"))

    def _copy_button(self, text):
        btn = Gtk.Button(icon_name="edit-copy-symbolic", tooltip_text=tr("copy"))
        btn.add_css_class("flat")
        btn.set_valign(Gtk.Align.CENTER)
        btn.connect("clicked", lambda _b: self.copy(text))
        return btn

    @staticmethod
    def clean_box(box):
        while (child := box.get_first_child()) is not None:
            box.remove(child)

    def add_row(self, group, title, value, copy=False):
        row = Adw.ActionRow(title=title)
        if copy:
            row.set_subtitle(str(value))
            row.set_subtitle_selectable(True)
            row.add_suffix(self._copy_button(value))
        else:
            lbl = Gtk.Label(label=str(value))
            lbl.add_css_class("dim-label")
            row.add_suffix(lbl)
        group.add(row)

    def add_member_row(self, group, member, is_owner):
        ip = member.get('ip', 'Unknown')
        cid = member.get('id', 'N/A')
        row = Adw.ActionRow(title=member.get('alias', cid))
        state = member.get('state', 'offline')
        sub = [ip, tr("st_" + state)]
        if member.get('conn'):
            sub.append(tr("conn_" + member['conn']))
        row.set_subtitle(" · ".join(sub))
        dot = Gtk.Image(icon_name="media-record-symbolic")
        dot.add_css_class({"online": "success", "unreachable": "warning"}.get(state, "dim-label"))
        row.add_prefix(dot)
        # Owner-only moderation. A malformed id would make hamachi reject the
        # command, so the buttons only appear once the id parsed cleanly.
        if is_owner and CLIENT_ID_RE.match(cid or ''):
            for action, icon in (("ban", "action-unavailable-symbolic"), ("kick", "list-remove-symbolic")):
                btn = Gtk.Button(icon_name=icon, tooltip_text=tr(action))
                btn.add_css_class("flat")
                btn.set_valign(Gtk.Align.CENTER)
                btn.connect("clicked", lambda _b, a=action: self.confirm_member_action(member, a))
                row.add_suffix(btn)
        row.add_suffix(self._copy_button(ip))
        group.add(row)

    def confirm(self, heading, body, ok_label, on_ok, *, destructive=True, extra=None):
        dialog = make_alert(self, heading, body)
        dialog.add_response("cancel", tr("cancel"))
        dialog.add_response("ok", ok_label)
        dialog.set_response_appearance(
            "ok", Adw.ResponseAppearance.DESTRUCTIVE if destructive else Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("cancel" if destructive else "ok")
        dialog.set_close_response("cancel")
        if extra is not None:
            dialog.set_extra_child(extra)

        def on_resp(_d, resp):
            if resp == "ok":
                on_ok()
        dialog.connect("response", on_resp)
        present_dialog(dialog, self)
        return dialog

    def network_dialog(self, kind):
        id_row = Adw.EntryRow(title=tr("id"))
        pw_row = Adw.PasswordEntryRow(title=tr("pw_label"))
        fields = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        fields.add_css_class("boxed-list")
        fields.append(id_row)
        fields.append(pw_row)
        call = HamachiBackend.join_network if kind == "join" else HamachiBackend.create_network
        done_key = "joined" if kind == "join" else "created"

        def submit():
            nid = id_row.get_text().strip()
            if nid:
                pw = pw_row.get_text()
                self.run_action(lambda: call(nid, pw), done_key, nid)

        dialog = self.confirm(tr(kind), "", tr("btn_" + kind), submit, destructive=False, extra=fields)
        dialog.set_response_enabled("ok", False)
        id_row.connect("changed", lambda r: dialog.set_response_enabled("ok", bool(r.get_text().strip())))

        def on_enter(_row):
            if id_row.get_text().strip():
                submit()
                dialog.close()
        id_row.connect("entry-activated", on_enter)
        pw_row.connect("entry-activated", on_enter)
        id_row.grab_focus()

    def confirm_member_action(self, member, action):
        nid = self.current_net_id
        cid = member.get('id')
        if not nid or not CLIENT_ID_RE.match(cid or ''):
            return
        name = member.get('alias', cid)
        call = HamachiBackend.evict_member if action == "kick" else HamachiBackend.ban_member
        done_key = "kicked" if action == "kick" else "banned"
        self.confirm(tr(action), tr("confirm_" + action).format(name=name), tr(action),
                     lambda: self.run_action(lambda: call(nid, cid), done_key, name))

    def confirm_network_action(self, net):
        nid, name = net['id'], net['name']
        if net['is_owner']:
            heading, body, ok = tr("delete"), tr("confirm_delete"), tr("btn_delete")
            call, done_key = HamachiBackend.delete_network, "deleted"
        else:
            heading, body, ok = tr("leave"), tr("confirm_leave"), tr("btn_leave")
            call, done_key = HamachiBackend.leave_network, "left"
        self.confirm(heading, body.format(name=name), ok,
                     lambda: self.run_action(lambda: call(nid), done_key, name))

    def report_action(self, result, done_key, name):
        ok, msg = result
        if not ok:
            self.toast(tr("action_failed").format(msg=msg or "unknown error"))
        elif done_key:
            self.toast(tr(done_key).format(name=name))

    def _busy_push(self):
        self._busy += 1
        self.spinner.start()

    def _busy_pop(self):
        self._busy = max(0, self._busy - 1)
        if not self._busy:
            self.spinner.stop()

    def _show_status_page(self, title, description=None, icon=None, child=None):
        self.clean_box(self.dash_page)
        page = Adw.StatusPage(title=title, description=description, icon_name=icon)
        page.set_vexpand(True)
        if child is not None:
            page.set_child(child)
        self.dash_page.append(page)
        self.stack.set_visible_child_name("dashboard")

    def _run_job(self, label, func):
        """Run a long setup step (daemon start, registration), then refresh."""
        self._last_state = None
        self.power_btn.set_visible(False)
        self._show_status_page(label)
        self._busy_push()

        def job():
            func()
            GLib.idle_add(finish)

        def finish():
            self._busy_pop()
            self.refresh_data()
            return GLib.SOURCE_REMOVE
        threading.Thread(target=job, daemon=True).start()

    def start_daemon_bg(self):
        self._run_job(tr("daemon_starting"), HamachiBackend.start_daemon_pkexec)

    def register_bg(self):
        self._run_job(tr("registering"), HamachiBackend.login)

    def refresh_data(self, quiet=False):
        """Fetch hamachi state off the main thread; only the newest result is applied."""
        self._refresh_gen += 1
        gen = self._refresh_gen
        self._refreshing = True
        if not quiet:
            self._last_state = None
            self._busy_push()

        def job():
            info = HamachiBackend.get_self_info()
            nets = HamachiBackend.get_networks() if "client id" in info else []
            GLib.idle_add(finish, info, nets)

        def finish(info, nets):
            if not quiet:
                self._busy_pop()
            if gen == self._refresh_gen:
                self._refreshing = False
                self._apply_refresh(info, nets)
            return GLib.SOURCE_REMOVE
        threading.Thread(target=job, daemon=True).start()

    def _auto_refresh(self):
        # Skip the tick while anything else is in flight, so a background poll
        # never races an action or a manual refresh.
        if not self._refreshing and not self._busy and self.get_visible():
            self.refresh_data(quiet=True)
        return GLib.SOURCE_CONTINUE

    def _apply_refresh(self, info, nets):
        # Polling returns the same state most of the time; only rebuild on change.
        state = json.dumps([LANG_CODE, info, nets], sort_keys=True)
        if state == self._last_state:
            return
        self._last_state = state

        if not info:
            self.networks_data = []
            self.clean_box(self.list_box)
            self.power_btn.set_visible(False)
            if not self.auto_start_attempted:
                self.auto_start_attempted = True
                self.start_daemon_bg()
                return
            btn_start = Gtk.Button(label=tr("btn_start_daemon"))
            btn_start.add_css_class("suggested-action")
            btn_start.add_css_class("pill")
            btn_start.set_halign(Gtk.Align.CENTER)
            btn_start.connect("clicked", lambda _b: self.start_daemon_bg())
            self._show_status_page(tr("daemon_down"), tr("err_status"),
                                   "network-offline-symbolic", btn_start)
            return
        self.auto_start_attempted = True

        # Auto-register the node with Hamachi on first run if it has never been
        # registered (no persistent 'client id' yet). 'hamachi login' registers
        # and brings the node online in one step.
        if "client id" not in info and not self.auto_login_attempted:
            self.auto_login_attempted = True
            self.register_bg()
            return

        status = info.get('status', 'Unknown')
        self.is_online = status.lower().startswith("logged in")
        self.power_btn.set_visible(True)
        if self.is_online:
            self.power_btn.set_icon_name("media-playback-stop-symbolic")
            self.power_btn.add_css_class("destructive-action")
            self.power_btn.remove_css_class("suggested-action")
        else:
            self.power_btn.set_icon_name("media-playback-start-symbolic")
            self.power_btn.add_css_class("suggested-action")
            self.power_btn.remove_css_class("destructive-action")
        self.apply_tooltips()
        self._keep_scroll(self.dash_scroll, lambda: self._build_dashboard(info, status))

        self.networks_data = nets
        if not any(n['id'] == self.current_net_id for n in nets):
            self.current_net_id = None
        self._keep_scroll(self.list_scroll, self._build_sidebar)

        net = next((n for n in nets if n['id'] == self.current_net_id), None)
        if net is None:
            self.stack.set_visible_child_name("dashboard")
        else:
            self._keep_scroll(self.net_scroll, lambda: self._build_network_page(net))

    def _build_dashboard(self, info, status):
        self.clean_box(self.dash_page)
        title = Gtk.Label(label=tr("status_sys"), xalign=0)
        title.add_css_class("title-1")
        self.dash_page.append(title)
        grp = Adw.PreferencesGroup()
        self.dash_page.append(grp)
        self.add_row(grp, tr("status"), tr_self_status(status))
        # "address" holds the IPv4 and IPv6 addresses separated by spaces.
        for addr in info.get('address', '').split():
            self.add_row(grp, tr("ipv6" if ':' in addr else "ipv4"), addr, copy=True)
        if 'client id' in info:
            self.add_row(grp, tr("client_id"), info['client id'], copy=True)
        if 'nickname' in info:
            self.add_row(grp, tr("nick"), info['nickname'])
        if 'version' in info:
            self.add_row(grp, tr("ver"), info['version'])

    def _build_sidebar(self):
        # Rebuilding emits row-selected; keep it from re-rendering the page twice.
        self.list_box.handler_block(self._row_handler)
        try:
            self.clean_box(self.list_box)
            if not self.networks_data:
                lbl = Gtk.Label(label=tr("no_net"))
                lbl.add_css_class("dim-label")
                lbl.set_margin_top(20)
                self.list_box.append(lbl)
                return
            for net in self.networks_data:
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                box.set_margin_top(10)
                box.set_margin_bottom(10)
                box.set_margin_start(10)
                name_lbl = Gtk.Label(label=net['name'], xalign=0)
                name_lbl.add_css_class("heading")
                name_lbl.set_ellipsize(Pango.EllipsizeMode.END)
                box.append(name_lbl)
                total = len(net['members'])
                n_online = sum(1 for m in net['members'] if m['state'] == 'online')
                sub = tr("online_count").format(n=n_online, total=total) if total else tr("no_peers")
                if not net['online']:
                    sub = f"{tr('st_offline')} • {sub}"
                sub_lbl = Gtk.Label(label=sub, xalign=0)
                sub_lbl.add_css_class("caption")
                sub_lbl.add_css_class("dim-label")
                box.append(sub_lbl)
                row = Gtk.ListBoxRow()
                row.set_child(box)
                row.net_id = net['id']
                self.list_box.append(row)
                if net['id'] == self.current_net_id:
                    self.list_box.select_row(row)
        finally:
            self.list_box.handler_unblock(self._row_handler)

    def on_network_selected(self, _box, row):
        if row is None or not hasattr(row, 'net_id'):
            return
        net = next((n for n in self.networks_data if n['id'] == row.net_id), None)
        if net is None:
            return
        self.current_net_id = net['id']
        self._build_network_page(net)
        self.net_scroll.get_vadjustment().set_value(0)

    def _build_network_page(self, net):
        self.stack.set_visible_child_name("details")
        self.clean_box(self.net_page)
        is_owner = net['is_owner']

        # Compact header (name + one line of facts) so the member list starts
        # above the fold instead of below a block of info rows.
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        text.set_hexpand(True)
        t = Gtk.Label(label=net['name'], xalign=0)
        t.add_css_class("title-1")
        t.set_ellipsize(Pango.EllipsizeMode.END)
        text.append(t)
        facts = []
        if net['name'] != net['id']:
            facts.append(f"{tr('id')}: {net['id']}")
        facts.append(f"{tr('cap')}: {net['capacity']}")
        facts.append(tr("st_online") if net['online'] else tr("st_offline"))
        if net['owner']:
            facts.append(f"{tr('owner')}: {tr('owner_you') if is_owner else net['owner']}")
        meta = Gtk.Label(label=" · ".join(facts), xalign=0, wrap=True, selectable=True)
        meta.add_css_class("dim-label")
        text.append(meta)
        header.append(text)

        copy_id = self._copy_button(net['id'])
        copy_id.set_tooltip_text(f"{tr('copy')} {tr('id')}")
        header.append(copy_id)
        btn = Gtk.Button(label=tr("btn_delete") if is_owner else tr("btn_leave"))
        btn.add_css_class("destructive-action")
        btn.set_valign(Gtk.Align.CENTER)
        btn.set_tooltip_text(tr("delete") if is_owner else tr("leave"))
        btn.connect("clicked", lambda _b: self.confirm_network_action(net))
        header.append(btn)
        self.net_page.append(header)

        grp_mem = Adw.PreferencesGroup(title=tr("members"))
        self.net_page.append(grp_mem)
        if net['members']:
            n_online = sum(1 for m in net['members'] if m['state'] == 'online')
            grp_mem.set_description(tr("online_count").format(n=n_online, total=len(net['members'])))
        else:
            grp_mem.set_description(tr("no_peers"))
        for m in net['members']:
            self.add_member_row(grp_mem, m, is_owner)

    def on_power_clicked(self, _btn):
        self.power_btn.set_sensitive(False)
        call = HamachiBackend.logoff if self.is_online else HamachiBackend.login
        self.run_action(call, None, None)

    def run_action(self, func, done_key, name):
        """Run a hamachi command in the background, then report and refresh."""
        self._busy_push()

        def job():
            result = func()
            time.sleep(1.0)  # give the daemon a moment before re-reading its state
            GLib.idle_add(finish, result)

        def finish(result):
            self._busy_pop()
            self.power_btn.set_sensitive(True)
            self.report_action(result, done_key, name)
            self.refresh_data()
            return GLib.SOURCE_REMOVE
        threading.Thread(target=job, daemon=True).start()


class HanuchiApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="com.github.hanuchi", flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_startup(self):
        Adw.Application.do_startup(self)
        quit_action = Gio.SimpleAction.new("quit", None)
        quit_action.connect("activate", lambda *_: self.quit())
        self.add_action(quit_action)
        self.set_accels_for_action("app.quit", ["<Control>q"])
        self.set_accels_for_action("win.refresh", ["<Control>r", "F5"])
        self.set_accels_for_action("win.settings", ["<Control>comma"])
        self.set_accels_for_action("win.join_network", ["<Control>j"])
        self.set_accels_for_action("win.create_network", ["<Control>n"])

    def do_activate(self):
        apply_theme(ConfigManager.load().get("theme", "system"))
        win = self.props.active_window or HanuchiWindow(self)
        win.present()


if __name__ == '__main__':
    GLib.set_prgname('hanuchi')
    sys.exit(HanuchiApp().run(sys.argv))
